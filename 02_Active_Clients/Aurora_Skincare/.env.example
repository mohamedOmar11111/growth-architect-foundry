# Copy this file to .env in this same folder and fill in real values.
# .env is gitignored — it will never be committed, per-tenant, automatically.

# Interpolated into every generated task/brief/draft for THIS tenant
# ("<OPERATOR_NAME> must review...", etc). Falls back to "the operator" if
# unset. Usually the same value across all your tenants unless a specific
# account manager owns this client.
OPERATOR_NAME=Your Name

# Optional but strongly recommended: this tenant's target cost per
# acquisition. The `diagnose` command judges conversion performance against
# it (without one, cost per acquisition cannot be judged at all — advice
# without a target is content, not media buying), and `audit` scores
# configuration higher when it's set. Compute it from break-even instead of
# guessing: `python core/engine/calc.py breakeven --price ...`, then use the
# "working target CPA" it prints. Can be overridden per run with
# `run_loop.py diagnose --target-cpa <value>`.
# TARGET_CPA=185

# Required for the ad-intel loop (core/engine/loops/ad_intel.py) to run live
# against this tenant's real Google Ads account. Get these from Google Ads
# API Center (developer token) + a Google Cloud OAuth client (client
# id/secret/refresh token). Until these are real, `run_loop.py ad-intel
# --client Aurora_Skincare` will fail loud with a clear "missing key" error
# — by design, no silent fallback to another tenant's credentials.
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CUSTOMER_ID=your_10_digit_customer_id_here

# Required for the meta-ads loop (core/engine/loops/meta_ads.py) to run live
# against this tenant's real Meta Ads account. Get the access token from
# Meta Business Suite -> System Users (a long-lived System User token, not
# a short-lived user token that expires in hours). Ad account id is the
# numeric part only — do not include the "act_" prefix, the loop adds it.
META_ACCESS_TOKEN=your_long_lived_system_user_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here_no_act_prefix
